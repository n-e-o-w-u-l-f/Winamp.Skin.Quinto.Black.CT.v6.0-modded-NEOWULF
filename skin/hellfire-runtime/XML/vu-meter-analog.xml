<groupdef id="vu.ma.group.main">
	<!-- COMPONENT BASE: do not remove width and height because we use setXmlParam() -->
	<Layer
		x="0" y="0" w="638" h="226"
		id="vu.ma.layer.base"/>
	<!-- COMPONENT BACKGROUND -->
	<Layer
		x="54" y="14" w="530" h="188"
		id="vu.ma.layer.component.filter.black"
		image="filter.black"
		tile="1"/>
	<Layer
		x="0" y="0" w="638" h="226"
		id="vu.ma.layer.component"
		image="vu.ma.component"/>
	<!-- COMPONENT LABEL -->
	<Layer
		x="170" y="20"
		id="vu.ma.layer.label"
		image="vu.ma.label"/>
	<!-- COMPONENT LABEL BOTTOM -->
	<Layer
		x="264" y="162"
		id="vu.ma.layer.label.bottom"
		image="vu.ma.label.bottom"/>
	<!-- SIDE PANEL: do not remove width and height because we use setXmlParam -->
	<Layer
		x="39" y="10" w="20" h="196"
		id="vu.ma.layer.side.panel.width.thin.left"/>
	<Layer
		x="579" y="10" w="20" h="196"
		id="vu.ma.layer.side.panel.width.thin.right"/>
	<Layer
		x="19" y="10" w="40" h="196"
		id="vu.ma.layer.side.panel.width.wide.left"/>
	<Layer
		x="579" y="10" w="40" h="196"
		id="vu.ma.layer.side.panel.width.wide.right"/>
	<!-- SIDE PANEL LIGHT REFLECTION -->
	<Layer
		x="39" y="-105" relaty="1"
		id="vu.ma.layer.side.panel.light.reflection.thin.left"
		image="side.panel.light.reflection.thin"/>
	<Layer
		x="579" y="-105" relaty="1"
		id="vu.ma.layer.side.panel.light.reflection.thin.right"
		image="side.panel.light.reflection.thin"/>
	<Layer
		x="19" y="-105" relaty="1"
		id="vu.ma.layer.side.panel.light.reflection.wide.left"
		image="side.panel.light.reflection.wide"/>
	<Layer
		x="579" y="-105" relaty="1"
		id="vu.ma.layer.side.panel.light.reflection.wide.right"
		image="side.panel.light.reflection.wide"/>
	<!-- SIDE PANEL SHADOW -->
	<Layer
		x="59" y="14" w="10" h="188"
		id="vu.ma.layer.side.panel.shadow.left"
		image="side.panel.shadow.left"/>
	<Layer
		x="569" y="14" w="10" h="188"
		id="vu.ma.layer.side.panel.shadow.right"
		image="side.panel.shadow.right"/>
	<!-- DISPLAY LEFT: BACKGROUND - SCALE (dB) - SCALE (PEAK) - SCALE (PERCENT) - NEEDLE - LIGHT (BOTTOM) - LED PEAK -->
	<Layer
		x="75" y="37" w="236" h="104"
		id="vu.ma.layer.display.background.left"
		image="vu.ma.display.background"/>
	<Layer
		x="71" y="33"
		id="vu.ma.layer.display.scale.db.left"
		image="vu.ma.display.scale.db"/>
	<Layer
		x="71" y="33"
		id="vu.ma.layer.display.scale.peak.left"
		image="vu.ma.display.scale.peak"/>
	<Layer
		x="71" y="33"
		id="vu.ma.layer.display.scale.percent.left"
		image="vu.ma.display.scale.percent"/>
	<Layer
		x="71" y="33"
		id="vu.ma.layer.display.needle.left"
		image="vu.ma.display.needle"/>
	<Layer
		x="71" y="33"
		id="vu.ma.layer.display.light.bottom.left"
		image="vu.ma.display.light.bottom"/>
	<Layer
		x="263" y="98"
		id="vu.ma.layer.display.peak.left"
		image="led.peak"/>
	<Layer
		x="263" y="98"
		id="vu.ma.layer.display.led.peak.left"
		image="led.red"
		visible="0"/>
	<!-- DISPLAY LEFT: LIGHT - OVERLAY - FRAME - LIGHT REFLECTION -->
	<Layer
		x="75" y="37" w="236" h="37"
		id="vu.ma.layer.display.light.left"
		image="display.light.white"
		tile="1"/>
	<Layer
		x="75" y="37" w="236" h="104"
		id="vu.ma.layer.display.overlay.left"
		image="display.overlay"/>
	<Layer
		x="71" y="33"
		id="vu.ma.layer.display.frame.left"
		image="vu.ma.display.frame"/>
	<Layer
		x="75" y="37"
		id="vu.ma.layer.light.reflection.left"
		image="vu.ma.light.reflection.left"/>
	<!-- DISPLAY RIGHT: BACKGROUND - SCALE (dB) - SCALE (PEAK) - SCALE (PERCENT) - NEEDLE - LIGHT (BOTTOM) - LED PEAK -->
	<Layer
		x="327" y="37" w="236" h="104"
		id="vu.ma.layer.display.background.right"
		image="vu.ma.display.background"/>
	<Layer
		x="323" y="33"
		id="vu.ma.layer.display.scale.db.right"
		image="vu.ma.display.scale.db"/>
	<Layer
		x="323" y="33"
		id="vu.ma.layer.display.scale.peak.right"
		image="vu.ma.display.scale.peak"/>
	<Layer
		x="323" y="33"
		id="vu.ma.layer.display.scale.percent.right"
		image="vu.ma.display.scale.percent"/>
	<Layer
		x="323" y="33"
		id="vu.ma.layer.display.needle.right"
		image="vu.ma.display.needle"/>
	<Layer
		x="323" y="33"
		id="vu.ma.layer.display.light.bottom.right"
		image="vu.ma.display.light.bottom"/>
	<Layer
		x="515" y="98"
		id="vu.ma.layer.display.peak.right"
		image="led.peak"/>
	<Layer
		x="515" y="98"
		id="vu.ma.layer.display.led.peak.right"
		image="led.red"
		visible="0"/>
	<!-- LIGHT - OVERLAY - FRAME - LIGHT REFLECTION -->
	<Layer
		x="327" y="37" w="236" h="37"
		id="vu.ma.layer.display.light.right"
		image="display.light.white"
		tile="1"/>
	<Layer
		x="327" y="37" w="236" h="104"
		id="vu.ma.layer.display.overlay.right"
		image="display.overlay"/>
	<Layer
		x="323" y="33"
		id="vu.ma.layer.display.frame.right"
		image="vu.ma.display.frame"/>
	<Layer
		x="327" y="37"
		id="vu.ma.layer.light.reflection.right"
		image="vu.ma.light.reflection.right"/>
	<!-- BUTTON "MENU" LEFT -->
	<Button
		x="164" y="160"
		id="vu.ma.button.menu.left"
		image="vu.ma.menu"
		hoverImage="vu.ma.menu.hover"
		downImage="vu.ma.menu.down"
		tooltip="Show additional options (left display)"/>
	<!-- BUTTON "MENU" RIGHT -->
	<Button
		x="416" y="160"
		id="vu.ma.button.menu.right"
		image="vu.ma.menu"
		hoverImage="vu.ma.menu.hover"
		downImage="vu.ma.menu.down"
		tooltip="Show additional options (right display)"/>
	<!-- XUI BUTTON "CLOSE" -->
	<button:close
		x="-108" y="17" relatx="1"
		id="button.close"/>
	<SendParams
		target="xui.button.close"
		tooltip="Close VU Meter Analog"/>
	<!-- POWER INDICATOR -->
	<Group
		x="82" y="-70" relaty="1"
		id="group.power.indicator"/>
	<script
		file="SCRIPTS\vu-meter-analog.maki"
		param="vu.ma.button.menu.left|vu.ma.layer.display.light.left|vu.ma.layer.display.light.bottom.left|vu.ma.layer.display.needle.left|vu.ma.layer.display.overlay.left|vu.ma.layer.display.led.peak.left|left"/>
	<script
		file="SCRIPTS\vu-meter-analog.maki"
		param="vu.ma.button.menu.right|vu.ma.layer.display.light.right|vu.ma.layer.display.light.bottom.right|vu.ma.layer.display.needle.right|vu.ma.layer.display.overlay.right|vu.ma.layer.display.led.peak.right|right"/>
</groupdef>
<Container
	default_x="100" default_y="100" default_w="638" default_h="226"
	default_visible="0"
	id="vu.meter.analog"
	name="VU Meter Analog"
	nomenu="1">
	<Layout
		x="100" y="100" w="638" h="226"
		id="normal"
		alphabackground="vu.ma.background.alpha">
		<Group
			fitparent="1"
			id="vu.ma.group.main"/>
	</Layout>
</Container>