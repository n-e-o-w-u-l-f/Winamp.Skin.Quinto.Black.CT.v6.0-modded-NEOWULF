	<!-- do not change the width: changing the width will change the width of all columns -->
	<Vis
		x="3" y="3" w="125" h="32"
		id="mp.vis.classic"
		channel="3"
		colorbandpeak="#969696"
		colorband16  ="#ffffff"
		colorband15  ="#ce2910"
		colorband14  ="#d65a00"
		colorband13  ="#d66600"
		colorband12  ="#d67300"
		colorband11  ="#c67b08"
		colorband10  ="#dea518"
		colorband9   ="#d6b521"
		colorband8   ="#bdde29"
		colorband7   ="#94de21"
		colorband6   ="#29ce10"
		colorband5   ="#32be10"
		colorband4   ="#39b510"
		colorband3   ="#319c08"
		colorband2   ="#299400"
		colorband1   ="#188408"
		colorosc5    ="#949ca5"
		colorosc4    ="#a0aaaf"
		colorosc3    ="#b5bdbd"
		colorosc2    ="#d6d6de"
		colorosc1    ="#ffffff"
