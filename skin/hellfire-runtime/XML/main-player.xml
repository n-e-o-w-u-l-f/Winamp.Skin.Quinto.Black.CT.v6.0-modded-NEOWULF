		x="87" y="37" w="462" h="22"
		id="mp.text.infoticker"
		align="center"
		altfont="Verdana"
		color="color.display.info"
		font="bitmapfont.songticker"
		fontsize="24"
		ghost="1"/> <!-- do not delete color and fontsize: needed for altfont; width= 33*14=462 -->
	<!-- PLAYBACK STATUS: if activated -->
	<Status
		x="79" y="66"
		id="mp.status.symbol"
		playBitmap="mp.status.symbol.play"
		pauseBitmap="mp.status.symbol.pause"
		stopBitmap="mp.status.symbol.stop"/>
	<Status
		x="79" y="66"
		id="mp.status.text"
		playBitmap="mp.status.text.play"
		pauseBitmap="mp.status.text.pause"
		stopBitmap="mp.status.text.stop"/>
	<AnimatedLayer
		x="79" y="79"
		id="mp.animatedlayer.status"
		image="mp.status.animation"
		autoplay="0"
		autoreplay="1"
		frameheight="13"
		speed="1000"/>
	<!-- TIMER -->
	<!-- timeroffstyle: How to display an empty timer (onStop): -->
	<!-- "0" = "  : " or "1" = "00:00" or "2"="" or "3"="0:00:00" or "4"=" :  :  " - we use visible -->
	<!-- timerhours="1" shows 1:00:00 instead of 60:00 but the minus sign appears after it is less than 1 hour -->
	<Text
		x="115" y="69" w="150" h="23"
		id="mp.text.timer"
		align="center"
		display="TIME"
		font="bitmapfont.timer"
		ghost="0"
		timecolonwidth="10"
		tooltip="Toggle between &quot;Time elapsed&quot; and &quot;Time remaining&quot;"/>
	<!-- TEXT MIN SEC: if activated -->
	<Layer
		x="0" y="98"
		id="mp.layer.MIN.SEC"
		image="mp.MIN.SEC"/>
	<!-- CHANNEL -->
	<Layer
		x="276" y="65"
		id="mp.layer.CHANNEL"
		image="mp.CHANNEL.none"/> <!-- NONE/MONO/STEREO/SURROUND -->
	<!-- TOGGLEBUTTON "SHUFFLE": just text on display -->
	<ToggleButton
		x="276" y="80"
		id="mp.togglebutton.SHUFFLE"
		image="mp.SHUFFLE.off"
		activeImage="mp.SHUFFLE.on"
		cfgattrib="{45f3f7c1-a6f3-4ee6-a15e-125e92fc3f8d};Shuffle"
		ghost="1"/>
	<!-- NSTATESBUTTON "REPEAT": just text on display -->
	<NStatesButton
		x="276" y="95"
		id="mp.nstatesbutton.REPEAT"
		image="mp.REPEAT"
		activeImage="mp.REPEAT"
		cfgattrib="{45f3f7c1-a6f3-4ee6-a15e-125e92fc3f8d};Repeat"
		cfgvals="0;1;-1"
		ghost="1"
		nstates="3"/> <!-- ghost="1" => remove Winamp's default hover state (on/off state only) -->
	<!-- TOGGLEBUTTON "EQUALIZER": just text on display -->
	<ToggleButton
		x="276" y="110"
		id="mp.togglebutton.EQUALIZER"
		image="mp.EQUALIZER.off"
		activeImage="mp.EQUALIZER.on"
		action="eq_toggle"
		ghost="1"/> <!-- ghost="1" => remove Winamp's default hover state (on/off state only) -->
	<!-- KBPS -->
