	<Group
		x="427" y="83" w="130" h="38"
		id="mp.group.beat.visualization"/>
	<!-- VISUALIZER: if activated -->
	<Group
		x="427" y="79" w="130" h="38"
		id="mp.group.vis.classic"/>
	<Group
		x="427" y="79" w="130" h="38"
		id="mp.group.vis.modern"/>
	<!-- VU METER: if activated -->
	<Group
		x="427" y="87" w="130" h="22"
		id="mp.group.vu.mdh"/>
	<!-- TOGGLEBUTTON "ML" + glow effect -->
	<ToggleButton
		x="84" y="110"
		id="mp.togglebutton.ML"
		image="mp.ML"
		downImage="mp.ML.down"
		activeImage="mp.ML.active"
		action="toggle"
		param="guid:{6b0edf80-c9a5-11d3-9f26-00c04f39ffc6}"
		rectrgn="1"
		tooltip="Open/Close Media Library "/> <!-- do not translate tooltip -->
	<Layer
		x="84" y="110"
		id="mp.layer.ml.glow"
		image="mp.ml.glow"
		ghost="1"/>
	<script
		file="SCRIPTS\hover-glow.maki"
		param="mp.togglebutton.ML|mp.layer.ml.glow"/>
