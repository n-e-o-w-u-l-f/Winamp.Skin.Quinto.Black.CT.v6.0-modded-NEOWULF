<groupdef id="mp.group.main">
	<!-- COMPONENT BASE: do not remove width and height because we use setXmlParam() -->
	<Layer
		x="0" y="0" w="638" h="246"
		id="mp.layer.base"/>
	<!-- COMPONENT BACKGROUND -->
	<Layer
		x="54" y="14" w="530" h="208"
		id="mp.layer.component.filter.black"
		image="filter.black"
		tile="1"/>
	<Layer
		x="0" y="0" w="638" h="246"
		id="mp.layer.component"
		image="mp.component"/>
	<!-- COMPONENT LABEL (QUINTO BLACK CT or WINAMP)-->
	<Layer
		x="248" y="20"
		id="mp.layer.label"
		image="mp.label.quinto.black.ct"/>
	<!-- SIDE PANEL: do not remove width and height because we use setXmlParam -->
	<Layer
		x="39" y="10" w="20" h="216"
		id="mp.layer.side.panel.width.thin.left"/>
	<Layer
		x="579" y="10" w="20" h="216"
		id="mp.layer.side.panel.width.thin.right"/>
	<Layer
		x="19" y="10" w="40" h="216"
		id="mp.layer.side.panel.width.wide.left"/>
	<Layer
		x="579" y="10" w="40" h="216"
		id="mp.layer.side.panel.width.wide.right"/>
	<!-- SIDE PANEL LIGHT REFLECTION -->
	<Layer
		x="39" y="-105" relaty="1"
		id="mp.layer.side.panel.light.reflection.thin.left"
		image="side.panel.light.reflection.thin"/>
	<Layer
		x="579" y="-105" relaty="1"
		id="mp.layer.side.panel.light.reflection.thin.right"
		image="side.panel.light.reflection.thin"/>
	<Layer
		x="19" y="-105" relaty="1"
		id="mp.layer.side.panel.light.reflection.wide.left"
		image="side.panel.light.reflection.wide"/>
	<Layer
		x="579" y="-105" relaty="1"
		id="mp.layer.side.panel.light.reflection.wide.right"
		image="side.panel.light.reflection.wide"/>
	<!-- SIDE PANEL SHADOW -->
	<Layer
		x="59" y="14" w="10" h="208"
		id="mp.layer.side.panel.shadow.left"
		image="side.panel.shadow.left"/>
	<Layer
		x="569" y="14" w="10" h="208"
		id="mp.layer.side.panel.shadow.right"
		image="side.panel.shadow.right"/>
	<!-- BACKGROUND - GRID - SHADOW -->
	<Layer
		x="75" y="37" w="488" h="22"
		id="mp.layer.display.background"
		image="display.background"/>
	<Layer
		x="74" y="37" w="488" h="22"
		id="mp.layer.display.grid"
		image="display.grid"
		tile="1"/> <!-- do not change the values - has to do with the songticker font -->
	<Layer
		x="75" y="37" w="488" h="22"
		id="mp.layer.display.shadow"
		image="display.shadow"/>
	<Text
		x="87" y="37" w="462" h="22"
		id="mp.text.songticker"
		align="center"
		altfont="Verdana"
		color="color.display.info"
		dblclickaction="trackinfo"
		display="SONGNAME"
		font="bitmapfont.songticker"
		fontsize="24"
		rightclickaction="trackmenu"
		visible="0"/> <!-- do not delete color and fontsize: needed for altfont; width= 33*14=462 -->
	<SongTicker
		x="87" y="37" w="462" h="22"
		id="mp.songticker"
		align="center"
		altfont="Verdana"
		color="color.display.info"
		dblclickaction="trackinfo"
		display="SONGNAME"
		font="bitmapfont.songticker"
		fontsize="24"
		rightclickaction="trackmenu"
		visible="0"/> <!-- do not delete color and fontsize: needed for altfont; width= 33*14=462 -->
