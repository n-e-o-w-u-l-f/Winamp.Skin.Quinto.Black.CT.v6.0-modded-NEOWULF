		x="390" y="65"
		id="mp.layer.KBPS"
		image="mp.KBPS"/>
	<Text
		x="433" y="65" w="45" h="7"
		id="mp.text.info.bitrate"
		align="left"
		font="bitmapfont.songinfo.data"/>
	<!-- KHZ -->
	<Layer
		x="484" y="65"
		id="mp.layer.KHZ"
		image="mp.KHZ"/>
	<Text
		x="518" y="65" w="38" h="7"
		id="mp.text.info.frequency"
		align="left"
		font="bitmapfont.songinfo.data"/>
	<!-- BEATS PER MINUTE: if activated -->
	<Layer
		x="353" y="80"
		id="mp.layer.BPM"
		image="mp.BPM"/>
	<Text
		x="387" y="80" w="28" h="7"
		id="mp.text.info.bpm"
		align="left"
		font="bitmapfont.songinfo.data"/>
