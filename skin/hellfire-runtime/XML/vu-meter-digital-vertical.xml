<groupdef id="vu.mdv.group.main">
	<!-- COMPONENT BASE: do not remove width and height because we use setXmlParam() -->
	<Layer
		x="0" y="0" w="300" h="468"
		id="vu.mdv.layer.base"/>
	<!-- COMPONENT BACKGROUND -->
	<Layer
		x="54" y="14" w="192" h="430"
		id="vu.mdv.layer.component.filter.black"
		image="filter.black"
		tile="1"/>
	<Layer
		x="0" y="0" w="300" h="468"
		id="vu.mdv.layer.component"
		image="vu.mdv.component"/>
	<!-- COMPONENT LABEL (none) -->
	<!-- COMPONENT LABEL BOTTOM -->
	<Layer
		x="95" y="405"
		id="vu.mdv.layer.label.bottom"
		image="vu.mdv.label.bottom"/>
	<!-- SIDE PANEL: do not remove width and height because we use setXmlParam -->
	<Layer
		x="39" y="10" w="20" h="438"
		id="vu.mdv.layer.side.panel.width.thin.left"/>
	<Layer
		x="241" y="10" w="20" h="438"
		id="vu.mdv.layer.side.panel.width.thin.right"/>
	<Layer
		x="39" y="10" w="20" h="438"
		id="vu.mdv.layer.side.panel.width.wide.left"/>
	<Layer
		x="241" y="10" w="20" h="438"
		id="vu.mdv.layer.side.panel.width.wide.right"/>
	<!-- SIDE PANEL LIGHT REFLECTION -->
	<Layer
		x="39" y="-105" relaty="1"
		id="vu.mdv.layer.side.panel.light.reflection.thin.left"
		image="side.panel.light.reflection.thin"/>
	<Layer
		x="241" y="-105" relaty="1"
		id="vu.mdv.layer.side.panel.light.reflection.thin.right"
		image="side.panel.light.reflection.thin"/>
	<Layer
		x="39" y="-105" relaty="1"
		id="vu.mdv.layer.side.panel.light.reflection.wide.left"
		image="side.panel.light.reflection.thin"/>
	<Layer
		x="241" y="-105" relaty="1"
		id="vu.mdv.layer.side.panel.light.reflection.wide.right"
		image="side.panel.light.reflection.thin"/> <!-- component has only thin width -->
	<!-- SIDE PANEL SHADOW -->
	<Layer
		x="59" y="14" w="10" h="430"
		id="vu.mdv.layer.side.panel.shadow.left"
		image="side.panel.shadow.left"/>
	<Layer
		x="231" y="14" w="10" h="430"
		id="vu.mdv.layer.side.panel.shadow.right"
		image="side.panel.shadow.right"/>
	<!-- LED ANIMATION -->
	<AnimatedLayer
		x="75" y="45"
		id="vu.mdv.animatedlayer.led.left"
		image="vu.mdv.led.animation.blue.left"
		autoplay="0"
		autoreplay="0"
		frameheight="311"/>
	<AnimatedLayer
		x="158" y="45"
		id="vu.mdv.animatedlayer.led.right"
		image="vu.mdv.led.animation.blue.right"
		autoplay="0"
		autoreplay="0"
		frameheight="311"/>
	<!-- LIGHT - OVERLAY - FRAME - LIGHT REFLECTION -->
	<Layer
		x="88" y="45" w="124" h="37"
		id="vu.mdv.layer.display.light"
		image="display.light.white"
		tile="1"/>
	<Layer
		x="75" y="45" w="150" h="311"
		id="vu.mdv.layer.display.overlay"
		image="display.overlay"/>
	<Layer
		x="71" y="41"
		id="vu.mdv.layer.display.frame"
		image="vu.mdv.display.frame"/>
	<Layer
		x="75" y="45" w="150" h="311"
		id="vu.mdv.layer.light.reflection"
		image="vu.mdv.light.reflection"
		tile="1"/>
	<!-- NSTATESBUTTON "COLOR" -->
	<NStatesButton
		x="135" y="366"
		id="vu.mdv.nstatesbutton.color"
		image="nstatesbutton.blue"
		hoverImage="nstatesbutton.blue.hover"
		downImage="nstatesbutton.blue.down"
		cfgvals="1;2"
		nstates="2"
		tooltip="Change LED color"/> <!-- nstatesbutton is a special togglebutton + remeber to use bitmap0, bitmap1, etc -->
	<Layer
		x="161" y="366"
		id="vu.mdv.layer.led.background.blue"
		image="led.background.blue"/>
	<Layer
		x="161" y="366"
		id="vu.mdv.layer.led.color"
		image="led.blue"/>
	<!-- XUI BUTTON "CLOSE" -->
	<button:close
		x="-108" y="21" relatx="1"
		id="button.close"/>
	<SendParams
		target="xui.button.close"
		tooltip="Close VU Meter Digital Vertical"/>
	<!-- POWER INDICATOR -->
	<Group
		x="72" y="18"
		id="group.power.indicator"/>
	<SendParams target="layer.power.label" x="4"  y="6"/>
	<SendParams target="layer.power.off"   x="56" y="0"/>
	<SendParams target="layer.power.on"    x="56" y="0"/>
	<script
		file="SCRIPTS\vu-meter-digital-vertical.maki"/>
</groupdef>
<Container
	default_x="100" default_y="100" default_w="300" default_h="468"
	default_visible="0"
	id="vu.meter.digital.vertical"
	name="VU Meter Digital Vertical"
	nomenu="1">
	<Layout
		x="100" y="100" w="300" h="468"
		id="normal"
		alphabackground="vu.mdv.background.alpha">
		<Group
			fitparent="1"
			id="vu.mdv.group.main"/>
	</Layout>
</Container>