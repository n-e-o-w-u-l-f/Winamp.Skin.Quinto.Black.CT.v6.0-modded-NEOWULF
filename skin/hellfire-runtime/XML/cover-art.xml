<groupdef id="ca.group.main" inherit_group="group.frame.noframe">
	<AlbumArt
		x="1" y="27" w="-2" h="-28" relatw="1" relath="1"
		id="ca.albumart"
		notfoundimage="not.found.image"
		stretched="0"/>
	<Layer
		x="1" y="27" w="-2" h="-28" relatw="1" relath="1"
		id="ca.layer.context.menu"/> <!-- area for component's own context menu -->
	<!-- XUI BUTTON "CLOSE" -->
	<button:close
		x="-48" y="6" relatx="1"
		id="button.close"/>
	<SendParams
		target="xui.button.close"
		tooltip="Close Cover Art"/>
	<script
		file="SCRIPTS\cover-art.maki"/>
</groupdef>
<Container
	default_x="100" default_y="100" default_w="252" default_h="278"
	default_visible="0"
	id="cover.art"
	name="Cover Art"
	nomenu="1">
	<Layout
		x="100" y="100" w="252" h="278"
		id="normal"
		background="base.texture"
		resizable="0">  <!-- entry name="odim" value="6,6" from studio.xnf since w="6" and h="6" and keep x,y,w,h in <Layout> -->
		<Group
			fitparent="1"
			id="ca.group.main"/>
	</Layout>
</Container>