<groupdef id="rgb.cc.group.slider.red">   <!-- keep slider as a group, it must have x="0" -->
	<Slider
		x="0" y="0" w="291" h="19"
		id="rgb.cc.slider.red"
		thumb="slider.progress.thumb"
		hoverThumb="slider.progress.thumb.hover"
		downThumb="slider.progress.thumb.down"
		tooltip="Change red channel's value (0-255)"/> <!-- 0-255 = width 255 + thumb -->
	<Layer
		x="0" y="0"
		id="rgb.cc.layer.thumb.red"
		image="slider.progress.thumb"
		ghost="1"
		visible="0"/>
</groupdef>
