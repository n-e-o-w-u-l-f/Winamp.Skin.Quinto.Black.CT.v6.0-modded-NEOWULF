	<Layer
		x="67" y="2"
		id="layer.display.bottom.frame.right"
		image="display.big.frame.right"/>
</groupdef>
<groupdef id="group.frame.noframe">
	<Layer
		x="0" y="0"
		id="layer.noframe.top.left"
		image="noframe.top.left"/>
	<Layer
		x="48" y="0" w="-96" relatw="1"
		id="layer.noframe.top"
		image="noframe.top"/>
	<Layer
		x="-48" y="0" relatx="1"
		id="layer.noframe.top.right"
		image="noframe.top.right"/>
	<Layer
		x="0" y="27" h="-30" relath="1"
		id="layer.noframe.left"
		image="noframe.left"
		resize="left"/> <!-- height of left frame: y-value + height of noframe.bottom.left: -(27+3) -->
	<Layer
		x="-1" y="27" h="-30" relatx="1" relath="1"
		id="layer.noframe.right"
		image="noframe.right"
		resize="right"/> <!-- height of right frame: y-value + height of noframe.bottom.right: -(27+3) -->
	<Layer
		x="0" y="-3" relaty="1"
		id="layer.noframe.bottom.left"
		image="noframe.bottom.left"
		resize="bottomleft"/>
	<Layer
		x="1" y="-1" w="-2" relaty="1" relatw="1"
		id="layer.noframe.bottom"
		image="noframe.bottom"
		resize="bottom"/>
	<Layer
		x="-1" y="-3" relatx="1" relaty="1"
		id="layer.noframe.bottom.right"
		image="noframe.bottom.right"
		resize="bottomright"/>
	<Text
		x="0" y="5" w="0" h="15" relatw="1"
		id="text.title.bar"
		align="center"
		antialias="1"
		bold="1"
		color="color.component.name"
		font="Verdana"
		fontsize="15"
		forceuppercase="1"
		ghost="1"
		text=":componentname"/> <!-- w="0" means text is as wide as the top frame and aligned in the middle -->
	<button:sysmenu
		x="30" y="6"
		id="button.sysmenu"/>
	<button:minimize
		x="-76" y="6" relatx="1"
		id="button.minimize"/>
</groupdef>
<groupdef id="group.frame.standardframe">
	<!-- STANDARDFRAME FOR SKIN'S WINDOWS -->
	<Layer
		x="0" y="0"
		id="layer.standardframe.top.left"
		image="standardframe.top.left"/>
	<Layer
		x="48" y="0" w="-96" relatw="1"
		id="layer.standardframe.top"
		image="standardframe.top"/> <!-- width equals -(48+48) (frame top left + frame top right -->
	<Layer
		x="-48" y="0" relatx="1"
		id="layer.standardframe.top.right"
		image="standardframe.top.right"/>
	<Layer
		x="0" y="32" h="-116" relath="1"
		id="layer.standardframe.left"
		image="standardframe.left"
		resize="left"/> <!-- height equals -(32+84) => h=-116 (frame top left + frame bottom left) -->
	<Layer
		x="-32" y="32" h="-116" relatx="1" relath="1"
		id="layer.standardframe.right"
		image="standardframe.right"
		resize="right"/> <!-- height equals -(32+84) => h=-116 (frame top left + frame bottom left) -->
	<Text
		x="0" y="5" w="0" h="15" relatw="1"
		id="text.title.bar"
		align="center"
		antialias="1"
		bold="1"
		color="color.component.name"
		font="Verdana"
		fontsize="15"
		forceuppercase="1"
		ghost="1"
		text=":componentname"/> <!-- w="0" means text is as wide as the top frame and aligned in the middle -->
	<button:sysmenu
		x="30" y="6"
		id="button.sysmenu"/>
	<button:minimize
		x="-76" y="6" relatx="1"
		id="button.minimize"/>
	<Layer
		x="0" y="-84" relaty="1"
		id="layer.standardframe.bottom.left"
		image="standardframe.bottom.left"
		resize="bottomleft"/>
	<Layer
		x="32" y="-32" w="-64" relaty="1" relatw="1"
		id="layer.standardframe.bottom"
		image="standardframe.bottom"
		resize="bottom"/> <!-- width equals -(31+31) (frame bottom left + frame bottom right) -->
	<Layer
		x="-32" y="-84" relatx="1" relaty="1"
		id="layer.standardframe.bottom.right"
		image="standardframe.bottom.right"
		resize="bottomright"/>
</groupdef>
<groupdef id="group.playback">
	<!-- BLUE AREA (stretchable) -->
	<Layer
		x="0" y="0" w="0" h="115" relatw="1"
		id="layer.playback.blue.background"
		image="filter.lightblue"
		tile="1"/>
	<Rect
		x="0" y="0" w="1" h="115"
		id="rect.playback.light.reflection.left"
		color="color.filter.lightblue.left.top"/>
	<Rect
		x="0" y="0" w="-1" h="1" relatw="1"
		id="rect.playback.light.reflection.top"
		color="color.filter.lightblue.left.top"/>
	<Rect
		x="-1" y="0" w="1" h="115" relatx="1"
		id="rect.playback.shadow.right"
		color="color.filter.lightblue.right.bottom"/>
	<Rect
		x="1" y="-1" w="0" h="1" relaty="1" relatw="1"
		id="rect.playback.shadow.bottom"
		color="color.filter.lightblue.right.bottom"/>
	<!-- SLIDER PROGRESS -->
	<Group
		x="11" y="-73" w="-22" h="31" relaty="1" relatw="1"
		id="wasabi.objectframe.group"/>
	<Layer
		x="13" y="-71" relaty="1"
		id="layer.slider.progress.background.left"
		image="slider.progress.background.left"/>
	<Layer
		x="41" y="-71" w="-83" relaty="1" relatw="1"
		id="layer.slider.progress.background.center"
		image="slider.progress.background.center"/> <!-- w = -(2 * x) + 1 because objectframe is 2px on the left side and 3px on the right -->
	<Layer
		x="-42" y="-71" relatx="1" relaty="1"
		id="layer.slider.progress.background.right"
		image="slider.progress.background.right"/>
	<ProgressGrid
		x="41" y="-60" w="-82" h="4" relaty="1" relatw="1"
		id="progress.grid"
		middle="progress.grid"/>
	<Slider
		x="41" y="-65" w="-82" h="19" relaty="1" relatw="1"
		id="slider.progress"
		thumb="slider.progress.thumb"
		hoverThumb="slider.progress.thumb.hover"
		downThumb="slider.progress.thumb.down"
		action="seek"/>
	<Slider
		x="41" y="-65" w="-82" h="19" relaty="1" relatw="1"
		id="slider.progress.ghost"
		thumb="slider.progress.thumb"
		hoverThumb="slider.progress.thumb.hover"
		downThumb="slider.progress.thumb.down"
		action="seek"
		tooltip="Seek "/> <!-- do not translate tooltip -->
	<Group
		x="11" y="-42" w="344" h="41" relaty="1"
		id="group.button.playback"/>
	<!-- SLIDER VOLUME -->
	<Group
		x="366" y="-33" w="145" h="24" relaty="1"
		id="wasabi.objectframe.group"/>
	<Layer
		x="368" y="-31" relaty="1"
		id="layer.volume.background.left"
		image="volume.background.left"/>
	<Layer
		x="388" y="-31" w="100" relaty="1"
		id="layer.volume.background.center"
		image="volume.background.center"/>
	<Layer
		x="488" y="-31" relaty="1"
		id="layer.volume.background.right"
		image="volume.background.right"/>
	<Layer
		x="388" y="-23" w="100" h="4" relaty="1"
		id="layer.bar.volume"
		image="bar.volume"/>
	<Slider
		x="375" y="-27" w="127" h="16" relaty="1"
		id="slider.volume"
		thumb="slider.volume.thumb"
		hoverThumb="slider.volume.thumb.hover"
		downThumb="slider.volume.thumb.down"
		action="volume"
		tooltip="Volume "/> <!-- do not translate tooltip -->
	<!-- NSTATESBUTTON LED "REPEAT" -->
	<Layer
		x="527" y="-43" relaty="1"
		image="led.background.blue"/>
	<NStatesButton
		x="527" y="-43" relaty="1"
		id="nstatesbutton.led.repeat"
		autoelements="0"
		cfgattrib="{45f3f7c1-a6f3-4ee6-a15e-125e92fc3f8d};Repeat"
		cfgvals="0;1;-1"
		image="led.off"
		activeImage="led.blue"
		ghost="1"
		nstates="3"/> <!-- do not remove autoelements="0" & ghost="1" => remove Winamp's default hover state (on/off state only) -->
	<Layer
		x="526" y="-17" relaty="1"
		id="layer.label.repeat"
		image="label.repeat"/>
	<!-- TOGGLEBUTTON LED "SHUFFLE"  -->
	<Layer
		x="567" y="-43" relaty="1"
		image="led.background.blue"/>
	<ToggleButton
		x="567" y="-43" relaty="1"
		id="togglebutton.led.shuffle"
		image="led.off"
		activeImage="led.blue"
		cfgattrib="{45f3f7c1-a6f3-4ee6-a15e-125e92fc3f8d};Shuffle"
		ghost="1"/> <!-- ghost="1" => remove Winamp's default hover state (on/off state only) -->
	<Layer
		x="566" y="-16" relaty="1"
		id="layer.label.shuffle"
		image="label.shuffle"/>
	<Group
		x="-111" y="-37" w="100" h="31" relatx="1" relaty="1"
		id="group.display.bottom"/>
</groupdef>
