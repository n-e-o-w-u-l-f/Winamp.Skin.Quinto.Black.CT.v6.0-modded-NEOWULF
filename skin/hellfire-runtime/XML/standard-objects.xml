		id="xui.button.close"
		image="caption.close"
		hoverImage="caption.close.hover"
		downImage="caption.close.down"
		action="close"
		inactiveAlpha="0"
		tooltip="Close "/> <!-- do not translate tooltip -->
</groupdef>
<groupdef id="group.xui.button.minimize" embed_xui="xui.button.minimize" xuitag="button:minimize">
	<Button
		id="xui.button.minimize"
		image="caption.minimize"
		hoverImage="caption.minimize.hover"
		downImage="caption.minimize.down"
		action="minimize"
		inactiveAlpha="0"
		tooltip="Minimize Winamp "/> <!-- do not translate tooltip -->
</groupdef>
<groupdef id="group.xui.button.sysmenu" embed_xui="xui.button.sysmenu" xuitag="button:sysmenu">
	<Button
		id="xui.button.sysmenu"
		image="caption.sysmenu"
		hoverImage="caption.sysmenu.hover"
		downImage="caption.sysmenu.down"
		action="sysmenu"
		inactiveAlpha="0"
		tooltip="Show main menu"/>
</groupdef>
<groupdef id="group.xui.nstatesbutton.frame" embed_xui="xui.nstatesbutton.frame" xuitag="nstatesbutton:frame">
	<!-- NSTATESBUTTON "FRAME" FOR ML, PE, VID, VIS -->
	<NStatesButton
		id="xui.nstatesbutton.frame"
		image="nstatesbutton.frame"
		hoverImage="nstatesbutton.frame.hover"
		downImage="nstatesbutton.frame.down"
		cfgvals="1;2;3"
		nstates="3"
		tooltip="Standard-Frame |Playback-Frame |No-Frame"/> <!-- nstatesbutton is a special togglebutton + remeber to use image0, image1, etc. -->
</groupdef>
<groupdef id="group.xui.text.field" inherit_group="wasabi.objectframe.group" embed_xui="xui.text.field" xuitag="text:field">
	<Text
		x="5" y="0" w="-10" h="0" relatw="1" relath="1"
		id="xui.text.field"
		align="center"
		valign="center"
		color="color.text.field"
		font="Verdana"
		fontsize="16"
		text=""/>
</groupdef>
<groupdef id="group.xui.text.info" embed_xui="xui.text.info" xuitag="text:info">
	<Text
		x="0" y="0" w="0" h="7" relatw="1"
		id="xui.text.info"
		font="bitmapfont.text.info"/> <!-- charcters*9+4 (2px from left + 2px from right) -->
</groupdef>
<!-- the following group overwrites the default checkbox look from checkbox.xml file; do not change the id! -->
<groupdef id="wasabi.checkbox.group">
	<ToggleButton
		x="0" y="0" w="120" h="15"
		id="checkbox.toggle"
		image="wasabi.button.checkbox"
		activeImage="wasabi.button.checkbox.pressed"
		rectrgn="1"/>
</groupdef>
<groupdef id="wasabi.standardframe.nostatusbar">
	<!-- STANDARDFRAME FOR THIRD-PARTY COMPONENTS LIKE PLUG-INS OR "QUEUE MANAGER" -->
	<Group
		x="0" y="0" w="0" h="0" relatw="1" relath="1"
		id="group.frame.standardframe"/>
	<!-- BUTTON "CLOSE" -->
	<Button
		x="-48" y="6" relatx="1"
		id="button.close"
		image="caption.close"
		hoverImage="caption.close.hover"
		downImage="caption.close.down"
		action="close"
		inactiveAlpha="0"
		tooltip="Close "/> <!-- do not translate tooltip -->
	<script
		file="SCRIPTS\standardframe.maki"
		param="32|32|-64|-64|0|0|1|1"/>
</groupdef>
<!-- the following group overwrites the default font and fontsize from titlebox.xml file; do not change the id! -->
