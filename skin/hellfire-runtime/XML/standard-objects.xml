<groupdef id="group.button.playback">
	<!-- do not remove width and height because we use setXmlParam -->
	<Group
		x="0" y="9" w="311" h="24"
		id="wasabi.objectframe.group"/>
	<!-- BUTTON "PREV" - image changeable via button-color.m script -->
	<Button
		x="2" y="11" w="40" h="19"
		id="button.prev"
		action="prev"
		tooltip="Previous "/> <!-- do not translate tooltip -->
	<!-- BUTTON "PLAY" - image changeable via button-color.m script -->
	<Button
		x="44" y="11" w="40" h="19"
		id="button.play"
		action="play"
		tooltip="Play/Restart "/> <!-- do not translate tooltip -->
	<!-- BUTTON "PAUSE" - image changeable via button-color.m script -->
	<Button
		x="86" y="11" w="40" h="19"
		id="button.pause"
		action="pause"
		tooltip="Pause/Unpause "/> <!-- do not translate tooltip -->
	<!-- BUTTON "STOP" - image changeable via button-color.m script -->
	<Button
		x="128" y="11" w="40" h="19"
		id="button.stop"
		action="stop"
		tooltip="Stop "/> <!-- do not translate tooltip -->
	<!-- BUTTON "NEXT" - image changeable via button-color.m script -->
	<Button
		x="170" y="11" w="40" h="19"
		id="button.next"
		action="next"
		tooltip="Next "/> <!-- do not translate tooltip -->
	<!-- BUTTON "EJECT" - image changeable via button-color.m script -->
	<Button
		x="212" y="11" w="40" h="19"
		id="button.eject"
		action="eject"
		tooltip="Open a File "/> <!-- do not translate tooltip -->
	<!-- BUTTON "MUTE" - image changeable via button-color.m script -->
	<Button
		x="254" y="11" w="54" h="19"
		id="button.mute"
		tooltip="Mute "/> <!-- do not translate tooltip -->
	<!-- BUTTON LED "MUTE" (ghost) -->
	<Layer
		x="311" y="6"
		image="led.background.blue"/>
	<Button
		x="311" y="6"
		id="button.led.mute"
		image="led.off"
		activeImage="led.blue"
		ghost="1"/> <!-- ghost="1" => remove Winamp's default hover state (on/off state only) -->
	<Status
		x="24" y="1" w="80" h="40"
		id="status.play"
		playBitmap="status.play"
		ghost="1"/> <!-- keep w and h -->
	<Status
		x="66" y="1" w="80" h="40"
		id="status.pause"
		pauseBitmap="status.pause"
		ghost="1"/> <!-- keep w and h -->
	<Status
		x="108" y="1" w="80" h="40"
		id="status.stop"
		stopBitmap="status.stop"
		ghost="1"/> <!-- keep w and h -->
</groupdef>
