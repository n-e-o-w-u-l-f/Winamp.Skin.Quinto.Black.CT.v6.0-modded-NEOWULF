<groupdef id="pe.group.options.crossfader">
	<Layer
		x="0" y="0" w="0" h="8" relatw="1"
		image="wasabi.framewnd.horizontaldivider"/>
	<Slider
		x="0" y="0" w="1" h="1"
		id="pe.slider.crossfader"
		cfgattrib="{f1239f09-8cc6-4081-8519-c2ae99fcb14c};Crossfade time"
		low="1"
		high="20"
		visible="0"/>
	<text:info
		x="20" y="36" w="121"
		text="DECREASE TIME"/>
	<!-- BUTTON "DECREASE" (OPTIONS: CROSSAFDER) -->
	<Button
		x="65" y="50"
		id="pe.button.crossfader.decrease"
		image="button.black"
		hoverImage="button.black.hover"
		downImage="button.black.down"
		activeImage="button.black.down"
		tooltip="Decrease Crossfader time "/> <!-- do not translate tooltip -->
	<Layer
		x="72" y="83"
		image="pe.minus"/>
	<!-- TEXT FIELD: CROSSFADER TIME -->
	<text:field
		x="150" y="52" w="95" h="25"
		id="pe.text.crossfader.time"
		text="-- no Time --"/>
	<text:info
		x="270" y="36" w="121"
		text="INCREASE TIME"/>
	<!-- BUTTON "INCREASE" (OPTIONS: CROSSAFDER) -->
	<Button
		x="315" y="50"
		id="pe.button.crossfader.increase"
		image="button.black"
		hoverImage="button.black.hover"
		downImage="button.black.down"
		activeImage="button.black.down"
		tooltip="Increase Crossfader time "/> <!-- do not translate tooltip -->
	<Layer
		x="322" y="83"
		image="pe.plus"/>
	<!-- ACTIVATE & CANCEL AREA -->
	<Layer
		x="-186" y="18" w="1" h="78" relatx="1"
		image="wasabi.groupbox.left"/>
	<text:info
		x="-170" y="36" w="76" relatx="1"
		text="ACTIVATE"/>
	<!-- TOGGLEBUTTON "ACTIVATE" (OPTIONS: CROSSAFDER) -->
	<ToggleButton
		x="-87" y="25" relatx="1"
		id="pe.togglebutton.crossfader.activate"
		image="button.black"
		hoverImage="button.black.hover"
		downImage="button.black.down"
		activeImage="button.black.active"
		action="toggle_crossfader"
		cfgattrib="{fc3eaf78-c66e-4ed2-a0aa-1494dfcc13ff};Enable crossfading"
		tooltip="Activate/Deactivate Crossfader"/>
	<!-- TOGGLEBUTTON LED "ACTIVATE" (OPTIONS: CROSSAFDER) -->
	<Layer
		x="-57" y="25" relatx="1"
		image="led.background.black"/>
	<ToggleButton
		x="-57" y="25" relatx="1"
		id="pe.togglebutton.led.crossfader.activate"
		image="led.off"
		activeImage="led.blue"
		action="toggle_crossfader"
		cfgattrib="{fc3eaf78-c66e-4ed2-a0aa-1494dfcc13ff};Enable crossfading"
		ghost="1"/> <!-- ghost="1" => remove Winamp's default hover state (on/off state only) -->
	<!-- BUTTON "CLOSE" (OPTIONS: CROSSFADER) -->
	<Button
		x="-23" y="13" relatx="1"
		id="pe.button.crossfader.close"
		image="caption.close"
		hoverImage="caption.close.hover"
		downImage="caption.close.down"
		tooltip="Close Crossfader"/> <!-- keep the close button in here so the group will not cover it -->
</groupdef>
