<groupdef id="pe.group.albumart.cuelist">
	<AlbumArt
		fitparent="1"
		id="pe.albumart"
		notfoundimage="not.found.image"
		stretched="0"/> <!-- in here we want to keep the ratio 1:1, not to stretch the image -->
	<List
		fitparent="1"
		id="pe.list.cuelist"
		background="pe.cuelist.background"
		nocolheader="1"
		tile="0"/> <!-- top-most-object -->
</groupdef>
<groupdef id="pe.group.buttons">
	<!-- keep width and height for folowing buttons which change color (darkblue/lightblue) -->
	<Group
		x="0" y="3" w="496" h="24"
		id="wasabi.objectframe.group"/>
	<!-- BUTTON "ADD" - image changeable via button-color.m script -->
	<Button
		x="2" y="5" w="45" h="19"
		id="pe.button.add"
		action="PE_Add"
		tooltip="Add files to playlist "/> <!-- do not translate tooltip -->
	<!-- BUTTON "REM" - image changeable via button-color.m script -->
	<Button
		x="49" y="5" w="72" h="19"
		id="pe.button.remove"
		action="PE_Rem"
		tooltip="Remove files from playlist "/> <!-- do not translate tooltip -->
	<!-- BUTTON "SELECT" - image changeable via button-color.m script -->
	<Button
		x="123" y="5" w="72" h="19"
		id="pe.button.select"
		action="PE_Sel"
		tooltip="Select files in playlist "/> <!-- do not translate tooltip -->
	<!-- BUTTON "MISC" - image changeable via button-color.m script -->
	<Button
		x="197" y="5" w="58" h="19"
		id="pe.button.misc"
		action="PE_Misc"
		tooltip="Miscellaneous actions "/> <!-- do not translate tooltip -->
	<!-- BUTTON "MANAGE PLAYLIST" - image changeable via button-color.m script -->
	<Button
		x="257" y="5" w="153" h="19"
		id="pe.button.manage.playlist"
		action="PE_List"
		tooltip="Manage playlist "/> <!-- do not translate tooltip -->
	<!-- BUTTON "OPTIONS" - image changeable via button-color.m script -->
	<Button
		x="412" y="5" w="81" h="19"
		id="pe.button.options"
		tooltip="Show additional features"/>
	<Layer
		x="417" y="5" w="81" h="19"
		id="pe.layer.mousetrap.button.options"
		cursor="IDC_ARROW"
		visible="0"/>
	<!-- BUTTON LED "OPTIONS" -->
	<Layer
		x="500" y="0"
		image="led.background.blue"/>
	<Button
		x="500" y="0"
		id="pe.button.led.options"
		image="led.off"
		activeImage="led.blue"
		ghost="1"/> <!-- ghost="1" => remove Winamp's default hover state (on/off state only) -->
